# ============================================================================
# Embedded AI-Based Traffic Violation Detection System
# Raspberry Pi 5 Edge Deployment - Environment Configuration
# ============================================================================

# ─── Application Settings ───
APP_NAME=Embedded Traffic Violation Detection System
APP_VERSION=1.0.0-edge
DEBUG=False
LOG_LEVEL=INFO
PLATFORM=raspberry_pi_5

# ─── Device Configuration ───
DEVICE=cpu
INFERENCE_SIZE=320
NUM_THREADS=4
TARGET_FPS=20

# ─── Camera Settings ───
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
CAMERA_BACKEND=v4l2

# ─── Model Paths (relative to project root) ───
YOLO_MODEL_PATH=models/best.pt
ONNX_MODEL_PATH=models/best.onnx
HELMET_MODEL_PATH=models/yolo11nHelmet_Detection_using_Yolo11.pt
PLATE_MODEL_PATH=models/yolo11n_numberplate.pt

# ─── Detection Thresholds ───
DETECTION_CONFIDENCE=0.50
NMS_IOU_THRESHOLD=0.45
OCR_CONFIDENCE=0.5

# ─── Database ───
DATABASE_URL=sqlite:///data/violations.db

# ─── API Server ───
API_HOST=0.0.0.0
API_PORT=8000

# ─── GPS Configuration ───
# Set to 'real' for USB GPS module, 'mock' for development
GPS_MODE=real
DEFAULT_LATITUDE=18.5204
DEFAULT_LONGITUDE=73.8567

# ─── Super-Resolution (SRGAN) ───
SR_MODEL_TYPE=auto
SR_DEVICE=cpu

# ─── Reporting ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Display ───
# Set to False for headless operation (no HDMI monitor)
SHOW_DISPLAY=False

# ─── LLM API Keys (Optional - requires internet) ───
GEMINI_API_KEY=
GROQ_API_KEY=
ALWAYS_VERIFY_WITH_LLM=False

# ─── Performance Tuning ───
# Process every Nth frame (1=all, 2=half, 3=third)
PROCESS_EVERY_N_FRAMES=1
# Maximum evidence images to keep (oldest deleted when exceeded)
MAX_EVIDENCE_IMAGES=1000
# Database cleanup: delete violations older than N days
AUTO_CLEANUP_DAYS=30
# Auto-cleanup to save SSD space
AUTO_CLEANUP_ENABLED=True

# ─── Speed Detection Configuration ───
# Camera calibration: pixels per meter (measure from overhead view)
# To calibrate: measure known distance in frame and calculate pixels/meter
PIXELS_PER_METER=8.0
# Speed limit in km/h
SPEED_LIMIT_KMH=60.0
# Speed violation threshold in km/h (when to trigger violation)
SPEED_VIOLATION_THRESHOLD=60.0
# Minimum track length (frames) before calculating speed
MIN_TRACK_LENGTH_SPEED=5
